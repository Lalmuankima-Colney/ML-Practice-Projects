import matplotlib.pyplot as plt
import numpy as np

models = ['Logistic Regression', 'Random Forest', 'XGBoost']

before_scores = [78.37, 81.00, 80.19]
before_stds   = [5.99, 0, 4.78]   # you didn't share RFC's baseline std, defaulting to 0

after_scores  = [79.07, 82.87, 82.72]
after_stds    = [6.81, 5.51, 6.11]

x = np.arange(len(models))
width = 0.35

fig, ax = plt.subplots(figsize=(9, 6))
bars1 = ax.bar(x - width/2, before_scores, width, yerr=before_stds, label='Before Tuning', capsize=5, color='#94a3b8')
bars2 = ax.bar(x + width/2, after_scores, width, yerr=after_stds, label='After Tuning', capsize=5, color='#3b82f6')

ax.set_ylabel('CV Accuracy (%)')
ax.set_title('Model Performance: Before vs After Hyperparameter Tuning')
ax.set_xticks(x)
ax.set_xticklabels(models)
ax.legend()
ax.set_ylim(60, 95)

# Add value labels on bars
for bars in [bars1, bars2]:
    for bar in bars:
        height = bar.get_height()
        ax.annotate(f'{height:.2f}', xy=(bar.get_x() + bar.get_width()/2, height),
                    xytext=(0, 3), textcoords="offset points", ha='center', fontsize=9)

plt.tight_layout()
plt.show()
