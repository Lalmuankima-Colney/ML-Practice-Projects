from sklearn.compose import ColumnTransformer
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import PowerTransformer, FunctionTransformer, OrdinalEncoder
from sklearn.pipeline import Pipeline
from sklearn.tree import DecisionTreeClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier
from sklearn.impute import KNNImputer
from xgboost import XGBClassifier

# Missing data
trf1 = ColumnTransformer([
    ('Imputed_Age', SimpleImputer(strategy='mean'), [2]),
    # ('Imputed_Age', KNNImputer(n_neighbors=3,weights='distance'), [2])
], remainder='passthrough')


# Transformation
trf2 = ColumnTransformer([
    ('transformed_Age', PowerTransformer(method='box-cox'), [0]),
    ('transformed_Fare', PowerTransformer(method='yeo-johnson'), [3])
], remainder='passthrough')

def cap_outliers(X):
    X = X.copy()
    col = X[:, 0].astype(float)
    q25, q75 = np.percentile(col, 25), np.percentile(col, 75)
    iqr = q75 - q25
    lower, upper = q25 - 1.5 * iqr, q75 + 1.5 * iqr
    X[:, 0] = np.clip(col, lower, upper)
    return X

# Outlier
trf3 = ColumnTransformer([
    ('Capped_Fare', FunctionTransformer(func=cap_outliers), [1])
], remainder='passthrough')


# OE
trf4 = ColumnTransformer([
    ('OE_Sex', OrdinalEncoder(categories=[['male', 'female']]), [3]),
], remainder='passthrough')

# trf5 = DecisionTreeClassifier(random_state=42)
# trf5 = LogisticRegression(random_state=42, max_iter=1000,C = 0.1, class_weight = None, penalty = 'l2', solver = 'liblinear')

trf5 = RandomForestClassifier(max_depth =10,max_features = 'sqrt', min_samples_split = 10,
                              n_estimators = 350,random_state=42,class_weight = 'balanced')
#trf5 = XGBClassifier(subsample = 0.7,reg_lambda = 2, reg_alpha = 0.5,n_estimators = 250, max_depth = 11,
#                     learning_rate = 0.05, colsample_bytree =0.7, random_state=42)


pipe = Pipeline([
    ('trf1', trf1),
    ('trf2', trf2),
    ('trf3', trf3),
    ('trf4', trf4),
    ('trf5', trf5)
])


# Best Parameters: {'trf5__max_depth': 10, 'trf5__max_features': 'sqrt', 'trf5__min_samples_split': 10, 'trf5__n_estimators': 300}
# Best CV Score: 0.8398601398601399

# Best Parameters: {'trf5__max_depth': 10, 'trf5__max_features': 'sqrt', 'trf5__min_samples_split': 10, 'trf5__n_estimators': 350}
# Best CV Score: 0.8426671919629666


from sklearn.model_selection import GridSearchCV

param_grid = {
    'trf5__n_estimators': [350, 400, 450, 500],
    'trf5__max_depth': [10,20,25],
    'trf5__min_samples_split': [10,15,20],
    'trf5__max_features': ['sqrt']
}

grid_search = GridSearchCV(
    pipe,
    param_grid=param_grid,
    cv=5,
    scoring='accuracy',
    n_jobs=-1,
    verbose=3
)

grid_search.fit(X_train, y_train)

print("Best Parameters:", grid_search.best_params_)
print("Best CV Score:", grid_search.best_score_)

# Print score for every combination tried
